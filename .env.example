NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/taskboard
LOG_LEVEL=info
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-characters
CLIENT_URL=http://localhost:5173
# Optional. Defaults to true in production; docker-compose sets false (plain http).
# COOKIE_SECURE=false
# Production only: the api's path on the web app's site when a proxy serves it (Vercel: /api),
# and the number of proxies in front of the api (Render + Vercel: 2). See docs/DEPLOY.md.
# API_PUBLIC_PATH=/api
# TRUST_PROXY=2
# Invite emails (optional). Without them, owners copy the invite link from the Share dialog.
# RESEND_API_KEY=
# EMAIL_FROM=Taskboard <invites@your-domain.dev>
# Web: where the browser calls the api. Baked into the web bundle at build time.
# A full URL here, or a path such as /api behind a proxy (then VITE_SOCKET_URL is required).
VITE_API_URL=http://localhost:4000
# Web (optional): where the live connection goes. Defaults to VITE_API_URL when it is a URL.
# VITE_SOCKET_URL=https://taskboard-api.onrender.com
